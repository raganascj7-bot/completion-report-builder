# Copy this file to ".env" (same folder) and fill in the values.
# Never commit .env to GitHub.

# --- App ---------------------------------------------------------------
APP_NAME="Completion Report Builder"
# Full address of the public folder, no trailing slash.
# Local XAMPP example: http://localhost/completion-report-builder/public
APP_URL=https://reports.jtdigitalmarketingservices.com
# true only on your own computer. Shows PHP errors on screen.
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila

# --- Database (MySQL / MariaDB) -----------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jt_reports
DB_USER=jt_reports_app
DB_PASS=change-me

# --- Uploads -----------------------------------------------------------
# Largest image a user may upload, in megabytes (client asked for 10).
UPLOAD_MAX_MB=10

# --- AI (OpenAI) -------------------------------------------------------
# Leave OPENAI_API_KEY empty to hide "Draft with AI" and skip the AI check of
# uploaded report designs (designs are still read from the PDF without it).
OPENAI_API_KEY=
# The client chose GPT-4o. OpenAI shuts gpt-4o down in the API on
# 14 January 2027; its official replacement is gpt-6-luna.
# Change only this line to switch models.
OPENAI_MODEL=gpt-4o
# How many AI requests (drafts and design checks) one person may make per day.
AI_DAILY_LIMIT_PER_USER=20

# --- Email (invitations and share notices) --------------------------------
# Leave MAIL_HOST empty to turn email off: the app then shows invitation links
# for the Admin to copy and send. Gmail: turn on 2-Step Verification, create an
# "App password" (Google Account → Security → App passwords) and paste it below.
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
# Gmail only sends from its own address.
MAIL_FROM=
MAIL_FROM_NAME="JT Digital Marketing Services"
# smtp = send for real; log = save emails in storage/logs/mail/ instead (testing).
MAIL_DRIVER=

# --- Sessions ----------------------------------------------------------
# Minutes of inactivity before a user is signed out.
SESSION_IDLE_MINUTES=240
