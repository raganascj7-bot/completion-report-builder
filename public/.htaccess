# Completion Report Builder — Apache rules for the public folder.

# Send every visitor to HTTPS (skipped on localhost so XAMPP still works).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# No folder listings.
Options -Indexes

# Hide dotfiles such as .env or .git if they ever end up here.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Upload limits (only works where PHP runs as an Apache module; otherwise
# set the same values in php.ini or the host's PHP settings page).
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_flag display_errors off
</IfModule>
